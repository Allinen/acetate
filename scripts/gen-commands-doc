#!/usr/bin/env bash
# Writes docs/commands.md from the commandlines' declarations (the schemas in the clients:
# clients/desktop/src/ui/commands.rs lists them), so the docs never drift from the app. The
# clients' tests check it (CI runs them): run this when one fails.
set -euo pipefail
export PATH="$HOME/.cargo/bin:$PATH"
cd "$(git rev-parse --show-toplevel)/clients"
ACETATE_WRITE_DOCS=1 cargo test --quiet -p acetate-desktop commands_doc_is_up_to_date -- --exact ui::commands::tests::commands_doc_is_up_to_date
