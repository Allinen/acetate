# Copy to .env next to compose.yaml and fill in.

POSTGRES_PASSWORD=change-me
# Where Postgres keeps its data on the server. Owned by ACETATE_UID:ACETATE_GID (below):
# Postgres runs as that user.
POSTGRES_DATA=/mnt/fast/acetate-postgres

# The fast disk (btrfs), mounted in the container as /pool: your music AND Acetate's main
# volume on it, e.g. /mnt/fast/Music and /mnt/fast/acetate. One mount, so imports from it
# are reflinks.
FAST_DISK=/mnt/fast
# The slow disk (MusicHD), mounted as /hdd, with Acetate's archive volume on it too (XFS
# with reflink, or ZFS with block cloning, also do reflinks).
SLOW_DISK=/mnt/hdd

# Acetate's volumes, as seen inside the container. The first is the default (and where
# covers go). Folders are created if missing.
ACETATE_VOLUMES=main=/pool/acetate,archive=/hdd/acetate

# The user id / group id that owns those folders (and POSTGRES_DATA) on the server. Both
# Postgres and Acetate run as it.
ACETATE_UID=1000
ACETATE_GID=1000

ACETATE_PORT=3000
# Behind an HTTPS reverse proxy:
#ACETATE_SECURE_COOKIES=true
#ACETATE_TRUST_PROXY=true
