# Copy to .env next to compose.yaml and fill in.

POSTGRES_PASSWORD=change-me
# Where Postgres keeps its data on the host. Owned by ACETATE_UID:ACETATE_GID (below):
# Postgres runs as that user.
POSTGRES_DATA=/srv/acetate-postgres

# The image to run: `docker build -t acetate .` makes acetate:latest. Set this if you
# push it to a registry instead.
#ACETATE_IMAGE=acetate:latest

# Host folders to make available to the container. DISK appears inside it as /disk. Acetate
# keeps its files in a volume there (see ACETATE_VOLUMES below), and `acetate ingest` can
# read music from anywhere under it, e.g. a host folder /srv/media/Music is /disk/Music.
# Use a folder on whichever disk you like; it only needs to be writable by ACETATE_UID.
DISK=/srv/media
# Optional second folder, appearing as /disk2 (uncomment its line in compose.yaml too),
# for a volume of its own, e.g. on a larger, slower drive.
#DISK2=/mnt/other

# Acetate's volumes (where it stores files), as paths inside the container. The first is
# the default (and where covers go). Folders are created if missing.
ACETATE_VOLUMES=main=/disk/acetate
#ACETATE_VOLUMES=main=/disk/acetate,archive=/disk2/acetate

# The user id / group id that owns those folders (and POSTGRES_DATA) on the host. Both
# Postgres and Acetate run as it.
ACETATE_UID=1000
ACETATE_GID=1000

ACETATE_PORT=3000
# Behind an HTTPS reverse proxy:
#ACETATE_SECURE_COOKIES=true
#ACETATE_TRUST_PROXY=true
