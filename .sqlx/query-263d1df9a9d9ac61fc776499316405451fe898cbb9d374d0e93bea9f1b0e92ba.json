  "query": "\n        SELECT id, user_agent, ip, created_at, last_used_at, expires_at,\n               id = $2 AS \"current!\"\n        FROM sessions\n        WHERE user_id = $1 AND expires_at > now()\n        ORDER BY id DESC\n        ",
