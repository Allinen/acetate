{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT f.id AS file_id, ss.id AS snapshot_id, s.id AS source_id, s.platform,\n               s.external_id, ss.captured_at, ss.data\n        FROM files f\n        JOIN source_snapshots ss ON ss.id = f.origin_snapshot_id\n        JOIN sources s ON s.id = ss.source_id\n        WHERE f.id = ANY($1)\n        ",
