  "db_name": "PostgreSQL",
  "query": "\n            SELECT c.trashed_at, c.blob_sha256 AS \"blob_sha256!\", c.mime, c.source, c.track_id, c.album_id,\n                   COALESCE(t.title, al.title) AS owner\n            FROM covers c\n            LEFT JOIN tracks t ON t.id = c.track_id\n            LEFT JOIN albums al ON al.id = c.album_id\n            WHERE c.id = $1\n            ",
