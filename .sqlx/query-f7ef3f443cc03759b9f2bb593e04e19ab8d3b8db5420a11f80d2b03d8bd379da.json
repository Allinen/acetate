{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT f.sha256, f.container, f.codec, f.bitrate\n        FROM tracks t\n        JOIN files f ON f.id = t.file_id\n        WHERE t.id = $1\n          AND (t.id = $2 OR EXISTS (\n              SELECT 1 FROM album_tracks at WHERE at.track_id = t.id AND at.album_id = $3\n          ))\n        ",
