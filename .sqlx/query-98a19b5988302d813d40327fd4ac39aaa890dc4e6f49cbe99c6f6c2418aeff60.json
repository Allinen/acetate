  "query": "\n        UPDATE lyrics l SET track_id = $2\n        WHERE l.track_id = $1\n          AND NOT EXISTS (SELECT 1 FROM lyrics k WHERE k.track_id = $2 AND k.body = l.body AND NOT k.removed)\n        RETURNING l.id\n        ",
