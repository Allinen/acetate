  "db_name": "PostgreSQL",
  "query": "\n        SELECT m.id, k.title AS kept_title, d.title AS merged_title, m.reason\n        FROM track_merges m\n        JOIN tracks k ON k.id = m.into_track_id\n        JOIN tracks d ON d.id = m.from_track_id\n        WHERE m.undone_at IS NULL\n        ORDER BY m.id\n        ",
