{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT al.id, al.title, al.kind,\n               GREATEST(CASE WHEN al.title ILIKE $2 THEN 1 ELSE 0 END,\n                        word_similarity($1, al.title))::real AS \"score!\"\n        FROM albums al\n        WHERE $1 <% al.title OR al.title ILIKE $2\n        ORDER BY 4 DESC, al.title\n        LIMIT $3\n        ",
