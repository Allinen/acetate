  "query": "\n                SELECT ss.id, s.track_id, s.trashed_at IS NOT NULL AS \"trashed!\"\n                FROM source_snapshots ss JOIN sources s ON s.id = ss.source_id\n                WHERE s.id = $1\n                ORDER BY ss.captured_at DESC, ss.id DESC\n                LIMIT 1\n                ",
