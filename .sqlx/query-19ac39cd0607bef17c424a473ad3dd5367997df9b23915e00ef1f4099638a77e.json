  "query": "\n        SELECT f.id AS file_id, t.id AS track_id\n        FROM files f JOIN tracks t ON t.file_id = f.id\n        WHERE f.sha256 = $1 AND f.purged_at IS NULL\n        ORDER BY t.id\n        LIMIT 1\n        ",
