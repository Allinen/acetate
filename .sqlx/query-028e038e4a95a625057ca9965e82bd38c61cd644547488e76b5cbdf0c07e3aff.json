{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT at.track_id,\n               EXISTS (SELECT 1 FROM covers c WHERE c.track_id = at.track_id\n                       AND c.blob_sha256 = $2 AND c.trashed_at IS NULL) AS \"has_it!\"\n        FROM album_tracks at\n        WHERE at.album_id = $1\n        ORDER BY at.track_id\n        ",
