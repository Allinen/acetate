{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT v.id, v.label, latest.id AS \"revision_id!\", latest.data AS \"data!\"\n        FROM track_variants v\n        CROSS JOIN LATERAL (\n            SELECT r.id, r.data FROM track_revisions r\n            WHERE r.variant_id = v.id ORDER BY r.id DESC LIMIT 1\n        ) latest\n        WHERE v.track_id = $1\n        ORDER BY v.id\n        ",
