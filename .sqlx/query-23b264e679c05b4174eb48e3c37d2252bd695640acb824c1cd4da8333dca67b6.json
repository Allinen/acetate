  "query": "\n        SELECT r.id, r.title, r.body, r.hidden, r.created_at, u.username AS \"created_by?\", r.reason\n        FROM note_revisions r LEFT JOIN users u ON u.id = r.created_by\n        WHERE r.note_id = $1\n        ORDER BY r.id DESC\n        ",
