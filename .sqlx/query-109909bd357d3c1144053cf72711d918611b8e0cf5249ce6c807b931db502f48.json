{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT al.id AS album_id, al.title, al.kind, at.disc_number, at.track_number\n        FROM album_tracks at\n        JOIN albums al ON al.id = at.album_id\n        WHERE at.track_id = $1\n        ORDER BY al.release_date NULLS LAST, al.title\n        ",
