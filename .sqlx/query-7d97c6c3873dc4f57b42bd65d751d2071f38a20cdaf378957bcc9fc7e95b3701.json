  "query": "\n        SELECT l.id, l.at, u.username AS \"by?\", l.action, l.detail, l.undone_at\n        FROM playlist_log l LEFT JOIN users u ON u.id = l.by_user\n        WHERE l.playlist_id = $1\n        ORDER BY l.id DESC\n        ",
