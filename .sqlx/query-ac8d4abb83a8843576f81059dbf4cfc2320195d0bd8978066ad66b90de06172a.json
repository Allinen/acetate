{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT r.track_id, r.variant_id AS \"variant_id!\", r.data\n        FROM track_revisions r\n        WHERE r.data @> $1\n          AND r.id = (SELECT r2.id FROM track_revisions r2\n                      WHERE r2.variant_id = r.variant_id ORDER BY r2.id DESC LIMIT 1)\n        ",
