  "query": "\n        SELECT r.album_id, r.data\n        FROM album_revisions r\n        WHERE r.data @> $1\n          AND r.id = (SELECT r2.id FROM album_revisions r2\n                      WHERE r2.album_id = r.album_id ORDER BY r2.id DESC LIMIT 1)\n        ",
