  "db_name": "PostgreSQL",
  "query": "\n            SELECT r.id, r.kind, r.variant_id, r.created_at, r.author_id,\n                   u.username AS \"author?\", r.source, r.reason, r.is_canon, r.data\n            FROM track_revisions r\n            LEFT JOIN users u ON u.id = r.author_id\n            WHERE r.track_id = $1\n            ORDER BY r.id DESC\n            ",
