  "query": "\n        SELECT c.id, c.changed_at, u.username AS \"changed_by?\", c.reason, c.old_name, c.new_name\n        FROM file_original_filename_changes c\n        LEFT JOIN users u ON u.id = c.changed_by\n        WHERE c.file_id = $1\n        ORDER BY c.id DESC\n        ",
