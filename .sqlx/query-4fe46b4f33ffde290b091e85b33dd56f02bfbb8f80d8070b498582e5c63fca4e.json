{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT m.id, f.title AS from_title, i.title AS into_title\n        FROM album_merges m\n        JOIN albums f ON f.id = m.from_album_id\n        JOIN albums i ON i.id = m.into_album_id\n        WHERE m.undone_at IS NULL\n        ORDER BY m.id\n        ",
