{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT c.blob_sha256 AS sha256, c.mime\n        FROM covers c\n        WHERE c.id = $1 AND c.trashed_at IS NULL\n          AND (c.track_id = $2\n               OR c.album_id = $3\n               OR EXISTS (\n                   SELECT 1 FROM album_tracks at WHERE at.track_id = c.track_id AND at.album_id = $3\n               ))\n        ",
