  "query": "\n        SELECT c.id, c.position FROM covers c\n        WHERE c.album_id = $1\n          AND NOT (c.trashed_at IS NULL AND EXISTS (SELECT 1 FROM covers k WHERE k.album_id = $2\n                   AND k.blob_sha256 = c.blob_sha256 AND k.trashed_at IS NULL))\n        ORDER BY c.position, c.id\n        ",
