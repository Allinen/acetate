  "query": "SELECT e.id AS extra_id, e.name, (e.hidden_at IS NOT NULL OR f.hidden_at IS NOT NULL) AS \"hidden!\"\n           FROM extra_files f JOIN extras e ON e.id = f.extra_id\n           WHERE f.sha256 = $1\n           ORDER BY 3, f.added_at\n           LIMIT 1",
