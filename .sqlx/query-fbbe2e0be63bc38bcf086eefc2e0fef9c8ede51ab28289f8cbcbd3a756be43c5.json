  "query": "\n        SELECT a.id, a.title, a.kind, a.release_date,\n               (SELECT r.id FROM album_revisions r\n                WHERE r.album_id = a.id ORDER BY r.id DESC LIMIT 1) AS revision_id\n        FROM albums a\n        WHERE a.id = $1\n        ",
