  "db_name": "PostgreSQL",
  "query": "\n        SELECT m.id, m.from_track_id, t.title AS from_title, m.merged_at, u.username AS \"merged_by?\",\n               m.undone_at\n        FROM track_merges m\n        JOIN tracks t ON t.id = m.from_track_id\n        LEFT JOIN users u ON u.id = m.merged_by\n        WHERE m.into_track_id = $1\n        ORDER BY m.id DESC\n        ",
