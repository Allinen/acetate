  "query": "\n        SELECT t.id, t.title, f.duration_ms, f.size_bytes\n        FROM tracks t\n        JOIN files f ON f.id = t.file_id\n        WHERE t.id = COALESCE((SELECT merged_into FROM tracks WHERE id = $1), $1)\n        ",
