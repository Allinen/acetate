{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT u.username, s.blob_sha256, extract(epoch FROM now() - s.staged_at)::bigint AS \"age!\"\n        FROM staged_covers s JOIN users u ON u.id = s.user_id\n        WHERE s.staged_at < now() - interval '1 day'\n        ORDER BY s.staged_at\n        ",
