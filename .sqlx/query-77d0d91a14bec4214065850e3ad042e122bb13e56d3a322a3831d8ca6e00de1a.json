  "query": "\n                SELECT r.id, r.created_at, u.username AS \"author?\", r.source, r.reason, r.data\n                FROM lyrics_revisions r\n                LEFT JOIN users u ON u.id = r.author_id\n                WHERE r.lyrics_id = $1\n                ORDER BY r.id DESC\n                ",
