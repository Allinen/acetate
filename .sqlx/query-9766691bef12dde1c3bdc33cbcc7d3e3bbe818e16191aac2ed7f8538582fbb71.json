{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT u.id, u.username, u.created_at,\n               u.password_hash IS NOT NULL AS \"has_password!\",\n               ARRAY(\n                   SELECT g.name FROM user_groups ug JOIN groups g ON g.id = ug.group_id\n                   WHERE ug.user_id = u.id ORDER BY g.name\n               ) AS \"groups!\"\n        FROM users u\n        WHERE u.id = $1\n        ",
