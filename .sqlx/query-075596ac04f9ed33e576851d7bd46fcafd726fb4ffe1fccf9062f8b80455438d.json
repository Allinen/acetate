  "query": "\n        SELECT l.changed_at, u.username AS \"changed_by?\", l.restricted, l.groups, l.reason\n        FROM track_access_log l\n        LEFT JOIN users u ON u.id = l.changed_by\n        WHERE l.track_id = $1\n        ORDER BY l.id DESC\n        ",
