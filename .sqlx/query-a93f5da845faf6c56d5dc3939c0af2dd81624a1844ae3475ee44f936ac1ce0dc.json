  "query": "\n        SELECT a.id, a.name, a.disambiguation, a.merged_into,\n               (SELECT r.id FROM artist_revisions r\n                WHERE r.artist_id = a.id ORDER BY r.id DESC LIMIT 1) AS revision_id\n        FROM artists a\n        WHERE a.id = $1\n        ",
