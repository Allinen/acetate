DATABASE_URL=postgres://acetate:acetate@127.0.0.1:5432/acetate
ACETATE_DATA_DIR=./data
# Smaller copies of cover images, made on first request (default: cache/ in the first
# volume). Only derived from the originals: safe to empty.
# ACETATE_CACHE_DIR=./data/cache
ACETATE_BIND=127.0.0.1:3000
RUST_LOG=acetate=debug,tower_http=info
ACETATE_WEB_DIR=./web
# Set to true when serving over HTTPS (session cookie is then only sent over HTTPS).
ACETATE_SECURE_COOKIES=false
# Set to true behind a reverse proxy that sets X-Forwarded-For (for the client address).
ACETATE_TRUST_PROXY=false
